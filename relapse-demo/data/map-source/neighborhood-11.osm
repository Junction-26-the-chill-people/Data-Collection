  <tag k="name:fi" v="Pellingin retken muistomerkki"/>
  <tag k="name:sv" v="Pellingekårens minnesmärke"/>
  <tag k="note" v="Ison muistomerkin kuvaus (i): &quot;A memorial object, which is especially large (one can go inside, walk on or through it) or high enough &quot;. Tämä ei täytä noita ehtoja, joten on pieni muistomerkki."/>
  <tag k="website" v="https://www.hamhelsinki.fi/veistos/pellingin-retken-muistomerkki/"/>
