  <tag k="addr:street" v="Iso Puistotie"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Itsenäisyyden kuusi v. 1917. Omistettu Suomen eduskunnalle tunnuslauseella: ”Sitä kuusta kuuleminen, jonka juurella asunto”. Muistoksi päivälle 6.12.1917, jolloin eduskunta mursi kansaltaan orjan ikeen virittäen sille vapauden soihdun."/>
  <tag k="memorial" v="stone"/>
  <tag k="name" v="Itsenäisyyden kuusen muistokivi"/>
  <tag k="name:en" v="Monument under the Spruce of Independence"/>
  <tag k="name:fi" v="Itsenäisyyden kuusen muistokivi"/>
  <tag k="name:sv" v="Självständighetsgranens minnesten"/>
  <tag k="start_date" v="1931"/>
  <tag k="toilets:wheelchair" v="no"/>
  <tag k="tourism" v="artwork"/>
  <tag k="website" v="https://www.hamhelsinki.fi/veistos/itsenaisyyden-kuusen-muistokivi/"/>
  <tag k="wheelchair" v="yes"/>
 </node>
