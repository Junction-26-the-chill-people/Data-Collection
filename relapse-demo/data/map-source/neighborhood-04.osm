  <tag k="amenity" v="social_facility"/>
  <tag k="description" v="Helsingin työllisyyspalveluiden Kampin toimipisteessä voit asioida ilman ajanvarausta. Neuvonnan asiantuntijamme ovat käytettävissäsi koko aukioloajan. Tilasta löytyy tietokoneita ja tulostimia."/>
  <tag k="description:en" v="You can visit the Kamppi office of the Helsinki Employment Services without an appointment. Our experts are available throughout opening hours. There are computers and printers that you can use to search for work and training."/>
  <tag k="description:fi" v="Helsingin työllisyyspalveluiden Kampin toimipisteessä voit asioida ilman ajanvarausta. Neuvonnan asiantuntijamme ovat käytettävissäsi koko aukioloajan. Tilasta löytyy tietokoneita ja tulostimia."/>
  <tag k="description:sv" v="Du kan uträtta ärenden vid Helsingfors sysselsättningstjänsters verksamhetsställen i Kampen utan att boka tid. Våra sakkunniga inom rådgivning står till ditt förfogande under hela öppettiden."/>
  <tag k="email" v="tyollisyyspalvelut@hel.fi"/>
  <tag k="name" v="Helsingin työllisyyspalvelut, Kampin toimipiste"/>
  <tag k="name:en" v="Helsinki Employment Services, Kamppi office"/>
  <tag k="name:fi" v="Helsingin työllisyyspalvelut, Kampin toimipiste"/>
