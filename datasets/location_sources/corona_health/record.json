0/", "scheme": "spdx"}}], "copyright": "Copyright (C) 2026 The Authors.", "description": "<p>This is the complete dataset from the Corona Health mhealth app, Mental Health for Adults (18+ Years). <br><br>The following files are included:</p>\n<p>Codebook_Baseline_EMA.xlsx: Codebook describing the data regarding baseline and EMA assessment.<br>Baseline.csv: Results from the baseline assessments.<br>Ema.csv: Results from the longitudinal (EMA) assessments.<br>APP_Baseline.csv: Information about app usage in the baseline assessments.<br>APP_EMA.csv: Information about app usage in the EMA assessments.<br>GPS_Baseline.csv: Information about GPS in the baseline assessments.<br>GPS_EMA.csv: Information about GPS in the EMA assessments.</p>"}, "custom_fields": {}, "access": {"record": "public", "files": "public", "embargo": {"active": false, "reason": null}, "status": "open"}, "files": {"enabled": true, "order": [], "count": 7, "total_bytes": 28784937, "entries": {"EMA.csv": {"id": "c30b5dde-2203-4b71-958f-a526443aa04c", "checksum": "md5:66f35a5afb42e6dee025a271acced6b5", "ext": "csv", "size": 2333014, "mimetype": "text/csv", "storage_class": "L", "key": "EMA.csv", "metadata": {}, "access": {"hidden": false}, "pids": {"epic": {"identifier": "http://hdl.handle.net/11304/3d792e77-a475-4083-aa50-017e9743569e", "provider": "epic", "client": "epic"}}, "transfer": {"type": "L"}, "crc32": "72eddd0a", "links": {"self": "https://b2share.eudat.eu/api/records/cgf63-kme28/files/EMA.csv", "content": "https://b2share.eudat.eu/api/records/cgf63-kme28/files/EMA.csv/content"}}, "Codebook_Baseline_EMA.xlsx": {"id": "35557264-7665-4895-b59d-f04006cb2732", "checksum": "md5:d2d95a205f20f8c533c84767523ef6b9", "ext": "xlsx", "size": 247432, "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "storage_class": "L", "key": "Codebook_Baseline_EMA.xlsx", "metadata": {}, "access": {"hidden": false}, "pids": {"epic": {"identifier": "http://hdl.handle.net/11304/acd01b5a-ed93-